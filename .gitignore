# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Node (only used locally for the http-server preview task)
node_modules/

# Exact duplicate of PROJECT_MASTER_DOCUMENTATION.md — the .md is the
# canonical copy tracked in this repo (renders nicely on GitHub).
PROJECT_MASTER_DOCUMENTATION.txt

# Real production DB credentials live ONLY on the server (set directly via
# SSH), never in git — this repo is public. Gitignoring this specific path
# also makes Hostinger's git auto-deploy PRESERVE the server's live copy
# instead of overwriting it with whatever placeholder sits in git on every
# push (verified: an earlier push without this wiped the live credentials).
web_app/api/db_config.php

# Same reasoning as db_config.php above, for the Meta WhatsApp Cloud API
# access token.
web_app/api/meta_whatsapp_config.php

# Raw Sketchfab download (model + zip) — the actual copy used by the app
# lives at web_app/assets/models/yamaha_r1.glb, which IS tracked.
/3d models/

# PWABuilder-generated Android package: contains signing.keystore + its
# plaintext password in signing-key-info.txt. This repo is public — never
# commit the keystore or its password, or anyone could sign a fake "update"
# to this app using our identity. Keep these files only on your own machine.
/apk_package/
/*.apk
/*.aab
/Accidiox - Google Play package.zip
